*.p12
*.jks
*.keystore
local.properties
rescue_secret*
*.key.properties

# ===== Build output / caches =====
build/
*/build/
**/build/
.gradle/
**/.gradle/
gradle/wrapper/*.jar.bak
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar

# ===== Toolchain / vendored binaries (installed locally, never tracked) =====
# Root-anchored only: a bare "tools/" also matched the Kotlin package
# src/closepaw/app/src/main/kotlin/ai/closepaw/voice/tools/ and silently dropped the
# whole device-capability layer from the repo.
/tools/
/src/closepaw/tools/
/sdk_tmp/

# ===== Large model weights & eval binaries =====
*.gguf
*.litertlm
*.onnx
*.tflite
*.bin
*.tar.gz
*.zip
llm_eval/*.gguf
llm_eval/runtime/
mobile-actions-eval/harness/
mobile-actions-eval/gallery/
mobile-actions-eval/*.apk
mobile-actions-eval/*.litertlm
asr_eval/wav/

# ===== Screen recordings / device screenshots & raw logs =====
*.mp4
*.webm
# Root-anchored only: "logs/" alone would also match the nested Gradle project's own run directory.
# The nested project is a separate repo snapshot (src/closepaw), whose logs/ is device/test output
# and must never be committed.
/logs/
/src/closepaw/logs/
*.png
*.jpg
*.jpeg
!docs/**/*.png
!docs/**/*.jpg

# ===== Device / session scratch =====
.wireless_target
*.log
cloudflared.log
screen-*.mp4
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/

# ===== Nested upstream clone metadata (source snapshot is vendored instead) =====
src/closepaw/.git/
src/closepaw/.claude/
src/closepaw/.codex/
src/closepaw/vendor_unused_sherpa/
src/closepaw/.gradle/
src/closepaw/app/build/
src/closepaw/build/
src/closepaw/.github/
src/closepaw/.git_local_backup/

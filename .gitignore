mobile-actions-eval/*.litertlm
asr_eval/wav/

# ===== Screen recordings / device screenshots & raw logs =====
*.mp4
*.webm
# Root-anchored only: "logs/" alone would also match the nested Gradle project's own run directory.
# The nested project is a separate repo snapshot (src/closepaw), whose logs/ is device/test output
# and must never be committed.
/logs/
/src/closepaw/logs/
*.png
*.jpg
*.jpeg
!docs/**/*.png
!docs/**/*.jpg
# Launcher art is source, not a screenshot: AndroidManifest references `@mipmap/ic_launcher`,
# `mipmap-anydpi-v26/ic_launcher.xml` references `@drawable/ic_launcher_foreground`, and AAPT2
# fails a clean checkout without them ("resource not found"). These exact paths are the only
# images re-included — device screenshots and capture output stay ignored.
!src/closepaw/app/src/main/res/mipmap-*/ic_launcher.png
!src/closepaw/app/src/main/res/mipmap-*/ic_launcher_round.png
!src/closepaw/app/src/main/res/drawable-*/ic_launcher_foreground.png

